<!DOCTYPE html>
<html>
    <body>
        {% block body %}
            <h1 style="color: #333; font-size: 1.5em; font-weight: bold;">Liste des jeux vidéo qui seront sortis dans les 7 prochains jours</h1>
            {% for game in videogames %}
                <div style="margin-bottom: 20px;">
                    <h2 style="color: #333; font-size: 1.5em; font-weight: bold;">{{ game.title }}</h2>
                    <p style="color: #666; font-weight: bold;">Sortie prévue le : {{ game.releaseDate|date('d/m/Y') }}</p>
                    <p style="color: #666; font-weight: bold;">Éditeur : {{ game.editor.name }}</p>
                    {% for category in game.categories %}
                        <p style="color: #666; font-weight: bold; margin-bottom: 5px; border: 1px solid #ccc; padding: 5px;">Genre : {{ category.name }}</p>
                    {% endfor %}
                </div>
            {% else %}
                <p>Aucun jeu vidéo prévu pour les 7 prochains jours.</p>
            {% endfor %}

        {% endblock %}
    </body>
</html>